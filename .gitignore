# ==========================
# Core
# ==========================

# Ignore the entire data folder (big raw files)
data/
!scripts/R/chapter3/data/
!scripts/R/chapter3/data/*

# Figures of all types, anywhere
*.png
*.pdf
*.jpeg
*.jpg

# Logs
*.log

# Large scientific data formats
*.nc
*.he5

# ==========================
# IDE / system cruft (safe defaults)
# ==========================
.DS_Store
__pycache__/
.ipynb_checkpoints/
.Rproj.user/
.idea/
.vscode/

# ==========================
# Optional: results/figures folder?
# ==========================
# If you want ALL results ignored:
# results/
# OR if you only want the images ignored (not metadata/code):
 results/figures/*.png
 results/figures/*.pdf
 results/figures/*.jpeg

 # diagnostics outputs
results/diagnostics/
scripts/python/processing/sensitivity/threshold/*.out
__pycache__/

# ==========================
# Future structure
# ==========================
# Documents you DO want tracked:
# documents/*.md   ← no ignore needed (they’ll be versioned)
# Jupyter notebooks you DO want tracked:
# notebooks/*.ipynb   ← no ignore needed (they’ll be versioned)
