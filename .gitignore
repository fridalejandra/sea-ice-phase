# ==========================
# Data — large files not for git
# ==========================

# Top-level data folder (raw inputs, big files)
data/

# Raw observational SIE data
scripts/R/observations/

# R chapter data outputs — generated by scripts, transfer via rsync
scripts/R/chapter3/data/
scripts/R/Ch3/data/

# Results — figures and data outputs are generated, not versioned
results/

# ==========================
# File types to ignore everywhere
# ==========================
*.png
*.pdf
*.jpeg
*.jpg
*.nc
*.he5
*.log
*.csv

# Exception — small reference CSVs that are genuinely part of the codebase
# Uncomment and add specific paths if needed, e.g.:
# !scripts/R/Ch3/data/rmse_summary.csv

# ==========================
# IDE and system cruft
# ==========================
.DS_Store
__pycache__/
.ipynb_checkpoints/
.Rproj.user/
.idea/
.vscode/

# ==========================
# Python
# ==========================
*.pyc
*.pyo
*.pyd
env/
venv/
.env/

# ==========================
# Cluster job outputs
# ==========================
*.out
*.err
scripts/python/processing/sensitivity/threshold/*.out