rmse_iac  <- sqrt(mean((circ_sub$Extent - circ_sub$fitted_invariant)^2))
cat("RMSE traditional:", round(rmse_trad, 4), "\n")
cat("RMSE invariant:  ", round(rmse_iac, 4), "\n")
cat("Pct improvement: ", round(100*(1 - rmse_iac^2/rmse_trad^2), 1), "%\n")
# Are they really that similar?
cat("Mean difference fitted_invariant vs trad_mean:",
round(mean(abs(circ_sub$fitted_invariant - circ_sub$trad_mean)), 4), "\n")
> circ_sub <- daily[daily$sector == "SIE_circumpolar" & daily$Year <= 2018, ]
