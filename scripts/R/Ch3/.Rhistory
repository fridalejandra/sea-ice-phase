# Replicate canonical script exactly on circumpolar 1979-2018
circ_sub <- daily[daily$sector == "SIE_circumpolar" &
daily$Year >= 1979 & daily$Year <= 2018, ]
# Traditional
trad <- tapply(circ_sub$Extent, circ_sub$DOY, mean)
circ_sub$trad_mean <- trad[as.character(circ_sub$DOY)]
rmse_trad <- sqrt(mean((circ_sub$Extent - circ_sub$trad_mean)^2))
# Invariant with k=25 — exactly as canonical script
library(mgcv)
gam_iac_k25 <- gam(Extent ~ s(DOY, bs = "cc", k = 25),
data = circ_sub,
knots = list(DOY = c(1, 365)))
circ_sub$fitted_iac_k25 <- predict(gam_iac_k25)
rmse_iac_k25 <- sqrt(mean((circ_sub$Extent - circ_sub$fitted_iac_k25)^2))
pct_k25 <- 100 * (1 - rmse_iac_k25^2 / rmse_trad^2)
cat("Traditional RMSE:", round(rmse_trad, 4), "\n")
cat("Invariant k=25 RMSE:", round(rmse_iac_k25, 4), "\n")
cat("Pct improvement:", round(pct_k25, 1), "%\n")
# What are the units in your current circumpolar data?
summary(circ_sub$Extent)
