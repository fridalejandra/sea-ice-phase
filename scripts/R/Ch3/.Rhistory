peak_trad <- max(trad)
peak_iac  <- max(circ_sub$fitted_invariant)
cat("Peak traditional DOY mean:", round(peak_trad, 3), "\n")
cat("Peak fitted_invariant:    ", round(peak_iac, 3), "\n")
cat("Difference:               ", round(peak_trad - peak_iac, 3), "\n")
# Check the mean level difference
cat("Mean trad_mean:           ", round(mean(circ_sub$trad_mean), 3), "\n")
cat("Mean fitted_invariant:    ", round(mean(circ_sub$fitted_invariant), 3), "\n")
